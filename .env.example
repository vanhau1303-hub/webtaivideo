# Copy file này thành .env rồi điền giá trị. KHÔNG đưa .env lên GitHub.

# Mật khẩu đăng nhập web (bắt buộc khi mở ra Internet)
APP_PASSWORD=
# Chuỗi ngẫu nhiên để ký cookie đăng nhập
SESSION_SECRET=

# Địa chỉ cố định trên Cloudflare Workers và token để máy nhà báo link tunnel mới
RELAY_URL=https://video4urduck.<ten-tai-khoan>.workers.dev
RELAY_TOKEN=

# Tuỳ chọn
# PORT=8686
# TUNNEL=0                 # đặt 0 để chỉ chạy trong máy, không mở tunnel
# UPDATE_INTERVAL_SEC=60   # bao lâu kiểm tra GitHub một lần
